{
	"name": "halalneo",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "node scripts/worker-types.mjs && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4174",
		"prepare": "svelte-kit sync || echo ''",
		"check": "node scripts/worker-types.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"gen": "node scripts/worker-types.mjs",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx scripts/seed.ts",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.25.0",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.37.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-cloudflare": "next",
		"@sveltejs/kit": "next",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.11",
		"auth": "^1.7.2",
		"better-auth": "^1.7.2",
		"better-sqlite3": "^13.0.3",
		"bits-ui": "^2.19.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"playwright": "^1.62.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.0.0",
		"wrangler": "^4.127.1"
	},
	"dependencies": {
		"@ai-sdk/openai": "^4.0.52",
		"@ai-sdk/svelte": "^5.0.85",
		"@lexical/code": "^0.49.0",
		"@lexical/history": "^0.49.0",
		"@lexical/html": "^0.49.0",
		"@lexical/link": "^0.49.0",
		"@lexical/list": "^0.49.0",
		"@lexical/markdown": "^0.49.0",
		"@lexical/plain-text": "^0.49.0",
		"@lexical/rich-text": "^0.49.0",
		"@lexical/selection": "^0.49.0",
		"@lexical/table": "^0.49.0",
		"@lexical/utils": "^0.49.0",
		"@mastra/ai-sdk": "^1.0.0",
		"@mastra/core": "^1.63.0",
		"ai": "^7.0.85",
		"aws4fetch": "^1.0.20",
		"clsx": "^2.1.1",
		"lexical": "^0.49.0",
		"marked": "^18.0.11",
		"mode-watcher": "^1.1.0",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.5.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
