# Hashed immutable assets — SvelteKit client build
/_app/*
	Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts
/fonts/*
	Cache-Control: public, max-age=31536000, immutable

# PWA assets
/manifest.json
	Cache-Control: public, max-age=86400
/sw.js
	Cache-Control: public, max-age=0, must-revalidate
/icons/*
	Cache-Control: public, max-age=31536000, immutable

# Media — served from R2 via /api/media (worker sets immutable cache headers,
# hooks sets edge policy). No static image rules needed here.

# Auth pages — never cache
/login
	Cache-Control: no-store, no-cache, must-revalidate
/register
	Cache-Control: no-store, no-cache, must-revalidate
